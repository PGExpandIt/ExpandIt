# Copy to .env and fill in. Runs on a host that allows outbound SMTP (NOT the
# edge). Never commit the real file - it holds the mailbox password and the shared
# secret that authorises the edge to send codes.

# ── Infomaniak SMTP (the sales@vallus.eu mailbox) ────────────────────────────
SMTP_HOST=mail.infomaniak.com
# 587 = STARTTLS (SMTP_SECURE=false), what Infomaniak recommends; 465 = implicit
# TLS (SMTP_SECURE=true) and also works.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@vallus.eu
SMTP_PASS=
# What recipients see in the From header.
MAIL_FROM=sales@vallus.eu
MAIL_FROM_NAME=vallus

# ── Message wording ──────────────────────────────────────────────────────────
CODE_SUBJECT=#Your vallus verification code
# {code} and {minutes} are substituted.
CODE_BODY=#Your vallus verification code is {code}. It is valid for {minutes} minutes. If you did not request this, ignore this e-mail.
CODE_TTL_MINUTES=10

# Footer appended under the message, after a `-- ` line. Paste the signature from
# the mailbox's webmail settings here: that one is applied by the webmail client
# only, so a message sent over SMTP does not carry it. Use \n for line breaks;
# leave empty for no footer.
MAIL_SIGNATURE=

# ── Access control ───────────────────────────────────────────────────────────
# Shared secret. The edge signs each /send-code request with HMAC-SHA256 over the
# raw body under this key; the mailer rejects anything that does not match. MUST be
# identical to KCHAT_MAILER_SECRET on the edge script. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILER_AUTH_SECRET=

# Per-recipient sends allowed per hour (anti email-bombing, on top of the signature).
# Codes and licences share it: one free-licence request costs two sends.
SEND_RATE_LIMIT_PER_HOUR=5

# ── Free licences (optional) ─────────────────────────────────────────────────
# The free signing key from playwrightRunner-license-gen/free-private.pem, base64 on
# one line. Leave empty and POST /send-license answers 404. It signs free-tier keys
# only - both runners hold such a key to the free tier - so it is the one key that
# may live on a server. Never put private.pem (the main key) here.
#   base64 < free-private.pem | tr -d '\n'
FREE_LICENSE_KEY_B64=
# Oldest release the customer can download that accepts free keys; quoted in the
# e-mail. Required once the key is set. 1.4.1 accepted them too but is no longer
# published, so 1.4.2 is the honest answer.
FREE_LICENSE_MIN_VERSION=1.4.2
# Days until expiry. 183 matches the generator; the runners reject more than 190.
FREE_LICENSE_TERM_DAYS=183
LICENSE_SUBJECT=Your free vallus licence
# Where the e-mail's download links come from: latest.json on this host names the
# current release. Unreachable -> the e-mail links the downloads page instead.
DOWNLOADS_URL=https://downloads.vallus.eu
# Record of issued free licences, one JSON object per line: what enforces one licence
# per organisation. Relative to the working directory; in the image that is
# /app/data, a volume in compose.yaml. Keep it backed up.
LICENSE_LEDGER_PATH=data/licenses.jsonl
# Optional body override; {company}, {key}, {expires}, {minVersion} and {downloads}
# are substituted, \n becomes a line break. Leave unset for the built-in text.
#LICENSE_BODY=

# ── Reverse proxy (docker compose only; ignored by the mailer itself) ────────
# The hostname Caddy requests a certificate for, and where the edge sends codes.
MAILER_DOMAIN=mailer.vallus.eu
# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=

PORT=8790
# Interface to bind. Loopback locally (reach it through a reverse proxy); set to
# 0.0.0.0 in a container, where the Service is what fronts the port.
BIND_HOST=127.0.0.1
