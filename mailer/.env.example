# Copy to .env and fill in. Runs on a host that allows outbound SMTP (NOT the
# edge). Never commit the real file — it holds the mailbox password and the shared
# secret that authorises the edge to send codes.

# ── Infomaniak SMTP (the sales@vallus.eu mailbox) ────────────────────────────
SMTP_HOST=mail.infomaniak.com
# 587 = STARTTLS (SMTP_SECURE=false), what Infomaniak recommends; 465 = implicit
# TLS (SMTP_SECURE=true) and also works.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@vallus.eu
SMTP_PASS=
# What recipients see in the From header.
MAIL_FROM=sales@vallus.eu
MAIL_FROM_NAME=vallus

# ── Message wording ──────────────────────────────────────────────────────────
CODE_SUBJECT=Your vallus verification code
# {code} and {minutes} are substituted.
CODE_BODY=Your vallus verification code is {code}. It is valid for {minutes} minutes. If you did not request this, ignore this e-mail.
CODE_TTL_MINUTES=10

# Footer appended under the message, after a `-- ` line. Paste the signature from
# the mailbox's webmail settings here: that one is applied by the webmail client
# only, so a message sent over SMTP does not carry it. Use \n for line breaks;
# leave empty for no footer.
MAIL_SIGNATURE=

# ── Access control ───────────────────────────────────────────────────────────
# Shared secret. The edge signs each /send-code request with HMAC-SHA256 over the
# raw body under this key; the mailer rejects anything that does not match. MUST be
# identical to KCHAT_MAILER_SECRET on the edge script. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAILER_AUTH_SECRET=

# Per-recipient sends allowed per hour (anti email-bombing, on top of the signature).
SEND_RATE_LIMIT_PER_HOUR=5

# ── Reverse proxy (docker compose only; ignored by the mailer itself) ────────
# The hostname Caddy requests a certificate for, and where the edge sends codes.
MAILER_DOMAIN=mailer.vallus.eu
# Let's Encrypt uses this only for expiry warnings.
ACME_EMAIL=

PORT=8790
# Interface to bind. Loopback locally (reach it through a reverse proxy); set to
# 0.0.0.0 in a container, where the Service is what fronts the port.
BIND_HOST=127.0.0.1
