# Copy to .env next to publish.mjs. Never commit the real file: the storage zone
# password can overwrite every published release.

# Bunny -> Storage -> the zone -> FTP & API Access.
BUNNY_STORAGE_ZONE=vallus-downloads
# The zone password (the read-write one, not the read-only). It doubles as the
# Storage API key and is sent as the AccessKey header.
BUNNY_STORAGE_PASSWORD=
# The zone's region endpoint. Falkenstein (DE) is https://storage.bunnycdn.com;
# other regions have a prefix, e.g. https://uk.storage.bunnycdn.com.
BUNNY_STORAGE_URL=https://storage.bunnycdn.com

# The pull zone hostname in front of the storage zone - what customers download from.
DOWNLOADS_BASE_URL=https://downloads.vallus.eu

# Optional: the account API key (Account settings -> API). Used only to purge
# latest.json from the CDN cache after a release; without it the old latest.json
# may be served until the cache expires.
BUNNY_API_KEY=

# Optional: where the archives are. Defaults to the workspace root, where
# pack-rs.sh and `npm run pack` write them.
#PACKAGES_DIR=
