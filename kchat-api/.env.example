# Copy to .env and fill in. Never commit the real file - the webhook URL (or the
# bot token) lets anyone post into your kChat channel.

# ── Transport ────────────────────────────────────────────────────────────────
# Pick ONE. The incoming webhook is the simplest and the default.
#
# A) Incoming webhook (recommended). In kChat: Product menu → Integrations →
#    Incoming Webhooks → Add. Copy the URL it gives you. It looks like:
#      https://<org>.kchat.infomaniak.com/hooks/xxxxxxxxxxxxxxxxxxxxxxxxxx
KCHAT_WEBHOOK_URL=

# B) Bot / personal access token (used only when KCHAT_WEBHOOK_URL is empty).
#    Needs the API base, a bot token and the target channel id.
KCHAT_API_BASE=
KCHAT_TOKEN=
KCHAT_CHANNEL_ID=

# ── Message presentation ─────────────────────────────────────────────────────
# Optional overrides. With the webhook transport, a channel name here overrides
# the webhook's default channel (e.g. "town-square"); username and icon change how
# the post is attributed. Ignored by the bot-token transport, which posts as itself.
KCHAT_CHANNEL=
KCHAT_USERNAME=vallus site
KCHAT_ICON_EMOJI=:envelope:

# Prefix line shown at the top of every relayed message, so it is obvious where it
# came from once it lands in the channel.
KCHAT_MESSAGE_PREFIX=New message from the vallus website

# Hard cap on the message body length. Anything longer is truncated.
KCHAT_MAX_MESSAGE_CHARS=4000

# ── Access & abuse control (same model as booking-api) ───────────────────────
# Comma-separated exact origins allowed to call this API. No wildcards.
ALLOWED_ORIGINS=https://vallus.eu,https://www.vallus.eu

PORT=8788

# Per-IP message attempts allowed per hour. A wrong OTP code is refunded rather
# than counted - guessing is already capped per token - so this value does not
# double as a cap on how many times a visitor may mistype the code from their inbox.
KCHAT_RATE_LIMIT_PER_HOUR=5

# Bot protection. Signs the proof-of-work challenge handed out by GET /config;
# leave it empty and the challenge is disabled (honeypot and rate limit still
# apply). Must be the same on every edge instance. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KCHAT_CHALLENGE_SECRET=
# Leading zero bits. 15 ≈ 0.3 s in a browser; each extra bit doubles that.
KCHAT_CHALLENGE_DIFFICULTY=15

# ── OTP e-mail verification (optional) ───────────────────────────────────────
# Enabled only when all three below are set. Then GET the flow is:
#   POST /request-code  → code e-mailed via the mailer, token returned
#   POST /message|/register with { code, token } → verified, then relayed to kChat
# Leave any of them empty and OTP is off (the message endpoints fall back to the
# proof-of-work challenge; /request-code returns 404).
#
# Signs the OTP tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
KCHAT_OTP_SECRET=
# The off-edge mailer service base URL (see ../mailer). The edge calls its
# /send-code over HTTP; the edge never opens SMTP itself.
KCHAT_MAILER_URL=
# Shared secret the edge signs the mailer request with. MUST equal the mailer's
# MAILER_AUTH_SECRET.
KCHAT_MAILER_SECRET=
# How long an emailed code stays valid.
KCHAT_OTP_TTL_MINUTES=10
