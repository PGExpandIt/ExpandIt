{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // booking-api is a separate service with its own tsconfig, its own
    // dependencies and its own build. Type-checking it from here made the
    // website build depend on `npm install` having been run inside it —
    // which CI never does, so the site failed on a fresh checkout with
    // "Cannot find module '@bunny.net/edgescript-sdk'".
    "booking-api"
  ]
}
