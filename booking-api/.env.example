# Copy to .env and fill in. Never commit the real file — the token grants full
# read/write access to the calendar and, with user_info, to account details.

# Personal API token from the Infomaniak manager (API Token page).
# Scopes required: workspace:calendar user_info
INFOMANIAK_TOKEN=

# Optional but recommended in production. Without it the first calendar on the
# account is used, so a new calendar appearing there could silently change the
# target. Run `npm run probe` to list the IDs.
INFOMANIAK_CALENDAR_ID=

# The timezone the offered slots are expressed in — your working hours, not the
# visitor's. Must be an IANA name.
BOOKING_TIMEZONE=Europe/Warsaw

# Who appears as the organiser on every booking, and therefore what address the
# prospect sees in the invitation. Leave empty to use the address on the token's
# Infomaniak profile — which is often a personal one. When set, the profile is not
# read at all, so the token does not even need the user_info scope.
BOOKING_ORGANIZER_EMAIL=sales@vallus.eu
BOOKING_ORGANIZER_NAME=vallus

# Comma-separated exact origins allowed to call this API. No wildcards.
ALLOWED_ORIGINS=https://vallus.eu

PORT=8787

# Bot protection. Signs the proof-of-work challenge handed out by /slots; leave it
# empty and the challenge is disabled (honeypot and rate limit still apply).
# Must be the same on every edge instance. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_CHALLENGE_SECRET=
# Leading zero bits. 15 ≈ 0.3 s in a browser; each extra bit doubles that.
BOOKING_CHALLENGE_DIFFICULTY=15

# Shared secret for POST /retention (the scheduled cleanup). Empty disables the
# endpoint entirely.
BOOKING_ADMIN_TOKEN=
BOOKING_RETENTION_PERIOD=6m

# Booking rules
BOOKING_WORKDAYS=1,2,3,4,5
BOOKING_SLOT_TIMES=09:00,11:00,13:00,15:00
BOOKING_SLOT_MINUTES=30
BOOKING_LEAD_HOURS=24
BOOKING_HORIZON_DAYS=30
BOOKING_TITLE_PREFIX=vallus demo
BOOKING_RATE_LIMIT_PER_HOUR=5
